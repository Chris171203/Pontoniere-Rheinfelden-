<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Simulator-only, ad-hoc test identity. Device builds use Apple's real team identity. -->
    <key>application-identifier</key><string>ch.pfvr.app.test</string>
    <key>keychain-access-groups</key><array><string>ch.pfvr.app.test</string></array>
</dict>
</plist>
